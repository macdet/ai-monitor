source .venv/bin/activate
export ROCM_SMI_PATH=/opt/rocm/bin/rocm-smi

# Pfad zur Ollama API auf deiner Proxmox-Workstation
export OLLAMA_API_BASE="http://192.168.178.182:11434"

# Aider spezifische Einstellungen, damit er nicht auf localhost sucht
export AIDER_OPENAI_API_BASE="http://192.168.178.182:11434/v1"

# Optional: Standard-Modell festlegen, falls die Config mal fehlt
export AIDER_MODEL="ollama_chat/qwen3-coder:30b"

# Falls du Python-Venv nutzt (optional, aber empfohlen für uv/pip)
# layout python


